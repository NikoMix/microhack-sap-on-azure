# Example environment variables for the Module B microhack. Copy to `.env` and fill in.
# NEVER commit a real `.env` — gitleaks and .gitignore are configured to keep secrets out.

# Azure context used by lab CLI snippets and `az` commands (each pupil uses their OWN subscription).
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=westeurope

# Resource group / naming prefix for the simulated SAP landing zone (keep it short & lowercase).
LAB_PREFIX=sapmodb
LAB_RESOURCE_GROUP=rg-sap-moduleb-lab

# Astro/GitHub Pages overrides (only needed if you fork to a different owner/repo).
# ASTRO_SITE=https://<your-user>.github.io
# ASTRO_BASE=/<your-fork-repo>

# ── MCP server variables (.vscode/mcp.json) ────────────────────────────────
# GitHub MCP server — in Codespaces, GITHUB_TOKEN is set automatically.
# For local dev, create a PAT with repo + read:org scopes.
GITHUB_TOKEN=ghp_your_github_pat_here

# Azure MCP server — service principal credentials (optional; az login works too).
# Leave blank to let the MCP server fall back to interactive az login.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
